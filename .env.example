PROJECT=pah-platform
LANDING_BUCKET=pah-platform-landing-036999274035

# Local path only, used when AWS_PROFILE is unset
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pah
POSTGRES_USER=pah
POSTGRES_PASSWORD=

# dbt runs from the repo root; these tell it where the project lives.
# dbt does not read .env itself: export them in the shell (or CI, or Dagster).
DBT_PROJECT_DIR=transform
DBT_PROFILES_DIR=transform
DBT_TARGET=dev
