[sqlfluff]
templater = dbt
# DuckDB first (ADR-012 amendment); a Snowflake-dialect lint returns in Phase 4.
dialect = duckdb
max_line_length = 120
exclude_rules = ST06, RF01

[sqlfluff:templater:dbt]
project_dir = transform
profiles_dir = transform

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower
